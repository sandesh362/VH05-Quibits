# ============================================================================
# Industrial Troubleshooting Platform - environment configuration
# ============================================================================
# Copy this file to .env and fill in real values. NEVER commit .env.
#
# Required secrets (generate with: openssl rand -hex 32):
#   JWT_SECRET, JWT_REFRESH_SECRET, INTERNAL_SERVICE_TOKEN
#
# MongoDB credentials (create a user/password; nothing ships in source).
# ============================================================================

# --- Application ------------------------------------------------------------
NODE_ENV=development
PYTHON_ENV=development
APP_NAME=industrial-troubleshooting-platform
API_PREFIX=/api/v1
RAG_API_PREFIX=/internal/v1
LOG_LEVEL=info
PORT=8080
RAG_SERVICE_PORT=8000

# --- HTTP / CORS ------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173
REQUEST_BODY_LIMIT=1mb
HEALTH_CHECK_TIMEOUT_MS=10000

# --- MongoDB (local only) ---------------------------------------------------
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=
MONGO_DB_NAME=itp
MONGO_PORT=27017
# Overridden by Docker Compose to the service name. Used by npm run dev:
MONGODB_URI=mongodb://root:<MONGO_ROOT_PASSWORD>@127.0.0.1:27017/itp?authSource=admin
MONGO_CONNECT_TIMEOUT_MS=8000

# --- Qdrant (local only) ----------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_PORT=6333
QDRANT_API_KEY=
# Collection holding manual chunk vectors.
QDRANT_MANUAL_COLLECTION=manual_chunks

# --- RAG / document service -------------------------------------------------
RAG_SERVICE_URL=http://localhost:8000
# Shared secret between Express and FastAPI. Generate: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=

# --- Ollama (host install; used for EMBEDDINGS only in Phase 3) -------------
OLLAMA_BASE_URL=http://localhost:11434
# In Docker, the services reach the host Ollama through this URL:
OLLAMA_BASE_URL_DOCKER=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=false
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_MS=5000

# --- Manual upload / PDF processing -----------------------------------------
# Maximum accepted manual PDF size, in megabytes.
MAX_MANUAL_FILE_SIZE_MB=100
# Where uploaded manual files live, relative to STORAGE_ROOT.
MANUAL_STORAGE_PATH=manuals

# Enable local OCR for scanned/text-poor PDFs. Requires Tesseract installed.
OCR_ENABLED=true
OCR_LANGUAGE=eng
# A page with fewer extractable characters than this is routed to OCR.
OCR_MIN_TEXT_CHARACTERS_PER_PAGE=50

# Chunking (characters).
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
MIN_CHUNK_SIZE=200
MAX_CHUNK_SIZE=1800

# Hard wall-clock cap for a single processing job.
MANUAL_PROCESSING_TIMEOUT_MS=1800000

# --- Storage ----------------------------------------------------------------
STORAGE_ROOT=./storage

# --- Authentication (Phase 2) ----------------------------------------------
JWT_SECRET=
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRATION=7d
JWT_ISSUER=itp-api
JWT_AUDIENCE=itp-web

# Account lockout.
AUTH_MAX_FAILED_LOGINS=10
AUTH_LOCKOUT_MINUTES=15
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MINUTES=15

# Who may confirm an incident resolution: self | supervisor.
INCIDENT_CONFIRMATION_MODE=self

# --- Optional bootstrap administrator (all-or-nothing) ----------------------
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Web --------------------------------------------------------------------
WEB_PORT=5173
APP_PORT=8080
VITE_API_BASE_URL=/api/v1

# --- Misc -------------------------------------------------------------------
QDRANT_LOG_LEVEL=INFO
# Set true to skip real dependency probes (unit tests only).
DISABLE_DEPENDENCY_CHECKS=false
