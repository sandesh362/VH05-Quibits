# ============================================================================
# ITP Field (mobile) - environment configuration
# ============================================================================
# Copy to .env and adjust. EXPO_PUBLIC_ variables are inlined into the JS
# bundle by the Expo CLI at start time - restart `expo start` after changes.
#
# IMPORTANT: `localhost` on the PHONE is the phone itself, not your computer.
# See docs/MOBILE_ENVIRONMENT.md and docs/EXPO_GO_SETUP.md.
# ============================================================================

# Base URL of the existing Express API (same server the web app uses).
# Physical device on the same Wi-Fi: use your development machine's LAN IP.
#   macOS/Linux: `ipconfig getifaddr en0` / `hostname -I | awk '{print $1}'`
#   Windows:     `ipconfig`  (IPv4 Address)
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.50:8080/api/v1

# Request timeout in milliseconds (assistant answers may take ~2 minutes).
EXPO_PUBLIC_API_TIMEOUT_MS=15000
# RAG endpoints get a longer budget.
EXPO_PUBLIC_RAG_TIMEOUT_MS=130000
